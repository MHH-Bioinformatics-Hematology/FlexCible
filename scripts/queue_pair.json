{
  "logdir": "runs/runner_pair",
  "jobs": [],
  "post": [
    {
      "name": "pairwise_build",
      "resource": "cpu",
      "cwd": "../pchic-unet",
      "cmd": [
        "/home/mh-hannover.local/wolffjoa/miniconda3/envs/hicdiff/bin/python",
        "-m",
        "pchicunet.pairwise",
        "build",
        "--config",
        "configs/pairwise.yaml"
      ]
    },
    {
      "name": "pairwise_train",
      "resource": "gpu",
      "cwd": "../pchic-unet",
      "deps": [
        "pairwise_build"
      ],
      "cmd": [
        "/home/mh-hannover.local/wolffjoa/miniconda3/envs/hicdiff/bin/python",
        "-m",
        "pchicunet.pairwise",
        "train",
        "--config",
        "configs/pairwise.yaml"
      ]
    },
    {
      "name": "pairwise_eval",
      "resource": "cpu",
      "cwd": "../pchic-unet",
      "deps": [
        "pairwise_train"
      ],
      "cmd": [
        "/home/mh-hannover.local/wolffjoa/miniconda3/envs/hicdiff/bin/python",
        "-m",
        "pchicunet.pairwise",
        "evaluate",
        "--config",
        "configs/pairwise.yaml",
        "--out",
        "runs/pairwise/metrics.json"
      ]
    },
    {
      "name": "minset_pchic",
      "resource": "gpu",
      "cwd": "../pchic-unet",
      "cmd": [
        "/home/mh-hannover.local/wolffjoa/miniconda3/envs/hicdiff/bin/python",
        "/home/mh-hannover.local/wolffjoa/src/hic-multiome-unet/scripts/minimal_set.py",
        "--config",
        "configs/gm12878_25kb.dropout.yaml",
        "--mode",
